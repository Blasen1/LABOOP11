@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
    <div style="display: flex; align-items: center; gap: 15px;">
        <span style="color: var(--text-dark);">Привіт, <strong>@User.Identity?.Name</strong></span>
        <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" style="display: inline;">
            <button type="submit" class="btn-login" style="padding: 8px 15px; font-size: 14px;">Вийти</button>
        </form>
    </div>
}
else
{
    <div style="display: flex; gap: 10px;">
        <a asp-area="Identity" asp-page="/Account/Login" class="btn-login">Вхід</a>
        <a asp-area="Identity" asp-page="/Account/Register" class="btn-secondary">Реєстрація</a>
    </div>
}

